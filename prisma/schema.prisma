// Luma — схема БД.
// Инварианты, которые схема обязана поддерживать (docs/decisions.md):
//  · №3  Entitlement.balance меняется ТОЛЬКО в одной транзакции с LedgerEntry.
//  · №4  Порядок списания: trial → purchased по expiresAt ASC NULLS LAST, затем createdAt ASC.
//  · №5  ProcessedUpdate — источник истины по дедупликации, не Redis.
//  · №8  Message.content и MemoryItem.content хранятся как AES-256-GCM ("v1:iv:tag:ct").
//  · №13 Entitlement.balance может быть отрицательным (долг после возврата).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URL живёт в prisma.config.ts, а рантайм-клиент получает
// driver adapter (@prisma/adapter-pg). В схеме url больше не поддерживается.
datasource db {
  provider = "postgresql"
}

// ─── Пользователь и профиль ───────────────────────────────────────────────────

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  telegramUserId       BigInt        @unique
  locale               String        @default("ru")
  ageGateStatus        AgeGateStatus @default(unknown)
  disclosureAcceptedAt DateTime?
  /// Выставляется при 403 от Telegram (бот заблокирован юзером) — отправки прекращаются.
  blockedAt            DateTime?
  /// Бан с нашей стороны за абуз.
  bannedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  profile          Profile?
  consents         Consent[]
  conversations    Conversation[]
  memoryItems      MemoryItem[]
  entitlements     Entitlement[]
  ledgerEntries    LedgerEntry[]
  payments         Payment[]
  moderationEvents ModerationEvent[]
  analyticsEvents  AnalyticsEvent[]

  @@index([createdAt])
}

/// Кастомизация персонажа. Решение №7: свободного текста здесь нет — только enum'ы
/// и теги из фиксированного каталога. companionName валидируется отдельно
/// (2–24 символа, /^[\p{L}\p{N} '-]+$/, blocklist) перед записью.
model Profile {
  userId        String           @id @db.Uuid
  displayName   String?
  timezone      String?
  companionName String           @default("Luma")
  tone          Tone             @default(warm)
  interests     String[]         @default([])
  boundaries    String[]         @default([])
  mode          ConversationMode @default(friendly)
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consent {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  type          ConsentType
  policyVersion String
  grantedAt     DateTime    @default(now())
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─── Диалог ───────────────────────────────────────────────────────────────────

model Conversation {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @db.Uuid
  mode   ConversationMode @default(friendly)
  /// Rolling summary (зашифрован). Решение №10: пересобирается каждые CONTEXT_SUMMARY_EVERY сообщений.
  summary            String?
  summaryAtMessageNo Int      @default(0)
  messageCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           MessageRole
  /// AES-256-GCM, формат "v1:iv:tag:ciphertext".
  content        String
  modality       Modality      @default(text)
  status         MessageStatus @default(ok)
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  /// Фактическая стоимость по usageMetadata провайдера, не оценка.
  costUsd        Decimal?      @db.Decimal(12, 8)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Решение №9: в MVP embeddings нет — retrieval выбирает активные факты напрямую.
/// Колонка под вектор добавится отдельной миграцией вместе с pgvector.
model MemoryItem {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  category       MemoryCategory
  /// AES-256-GCM, формат "v1:iv:tag:ciphertext".
  content        String
  consentVersion String
  confidence     Float?
  /// Для episodic_summary — now() + MEMORY_EPISODIC_TTL_DAYS.
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, expiresAt])
}

// ─── Коммерция ────────────────────────────────────────────────────────────────

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  sku            String      @unique
  type           ProductType
  title          String
  description    String
  priceXtr       Int
  /// Инкрементируется при смене цены. Попадает в invoice payload и проверяется на pre_checkout.
  priceVersion   Int         @default(1)
  /// Сколько сообщений начисляет пакет (null для не-пакетов).
  grantsMessages Int?
  active         Boolean     @default(true)
  config         Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Entitlement {
  id     String          @id @default(uuid()) @db.Uuid
  userId String          @db.Uuid
  sku    String
  kind   EntitlementKind
  /// Меняется только вместе с LedgerEntry в одной транзакции. Может быть < 0 (решение №13).
  balance         Int               @default(0)
  status          EntitlementStatus @default(active)
  sourcePaymentId String?           @db.Uuid
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([userId, status])
  @@index([userId, kind, expiresAt])
}

/// Append-only. Обновление и удаление записей запрещены на уровне кода.
model LedgerEntry {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  entitlementId String?          @db.Uuid
  eventType     LedgerEventType
  delta         Int
  /// Гарантия ровно-однократности. Примеры:
  ///   trial_grant:<userId>
  ///   debit:<messageId>
  ///   purchase:<telegramChargeId>
  ///   refund:<telegramChargeId>
  idempotencyKey String          @unique
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlement Entitlement? @relation(fields: [entitlementId], references: [id])

  @@index([userId, createdAt])
  @@index([entitlementId])
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  /// Идемпотентность fulfillment: повторный successful_payment с тем же id не начисляет второй раз.
  telegramChargeId String        @unique
  providerChargeId String?
  sku              String
  amountXtr        Int
  currency         String        @default("XTR")
  status           PaymentStatus @default(succeeded)
  invoicePayload   String
  /// SHA-256 сырого payload. Сам payload с платёжными данными не логируется.
  rawPayloadHash   String
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Инфраструктура ───────────────────────────────────────────────────────────

/// Решение №5. Источник истины по дедупликации Telegram updates.
/// Записи старше 24 часов вычищаются фоновой задачей.
model ProcessedUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ModerationEvent {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String?            @db.Uuid
  direction ModerationDirection
  category  String
  action    ModerationAction
  messageId String?            @db.Uuid
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([category, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

/// Решение №14. Источник для воронки и метрик стоимости.
model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  event     String
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AgeGateStatus {
  unknown
  confirmed_adult
  declined
}

enum Tone {
  warm
  playful
  calm
  witty
}

/// Романтический режим в MVP отсутствует осознанно (docs/decisions.md §0).
enum ConversationMode {
  friendly
  story
  language_practice
  creative
}

enum ConsentType {
  disclosure
  memory
  age_18plus
  media
}

enum MessageRole {
  user
  assistant
  system
}

enum Modality {
  text
  voice
  image
  video
}

enum MessageStatus {
  ok
  refused
  failed
}

enum MemoryCategory {
  profile
  preferences
  episodic_summary
}

enum ProductType {
  message_pack
  theme_pack
  customization
  memory_plus
}

enum EntitlementKind {
  trial
  purchased
}

enum EntitlementStatus {
  active
  exhausted
  expired
  refunded
}

enum LedgerEventType {
  trial_grant
  purchase_credit
  debit
  refund_reversal
  admin_adjustment
}

enum PaymentStatus {
  succeeded
  refunded
}

enum ModerationDirection {
  input
  output
}

enum ModerationAction {
  allow
  refuse
  escalate
  block
}
