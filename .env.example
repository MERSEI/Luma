# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ── Telegram ──────────────────────────────────────────────────────────────────
# Получить у @BotFather. Для staging заведите ОТДЕЛЬНОГО бота.
TELEGRAM_BOT_TOKEN=
# polling — локально, webhook — прод. Локально ngrok не нужен.
TELEGRAM_MODE=polling
# Только для TELEGRAM_MODE=webhook: публичный HTTPS-адрес сервиса.
TELEGRAM_WEBHOOK_URL=
# Случайная строка 32+ символов. Telegram шлёт её в X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Telegram user ID администраторов через запятую (для /admin-команд и возвратов).
ADMIN_TELEGRAM_IDS=

# ── База данных ───────────────────────────────────────────────────────────────
# Порт 5434 — 5432/5433 заняты другими локальными проектами.
DATABASE_URL=postgresql://luma:luma@localhost:5434/luma?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
# Порт 6381 — 6379/6380 заняты другими локальными проектами.
REDIS_URL=redis://localhost:6381

# ── Gemini ────────────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# См. docs/pricing.md. Дефолт flash-lite — экономика не сходится на flash.
GEMINI_MODEL_TRIAL=gemini-3.1-flash-lite
GEMINI_MODEL_PAID=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2

# ── Шифрование содержимого ────────────────────────────────────────────────────
# 32 байта в base64. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВНИМАНИЕ: смена ключа делает нечитаемыми все ранее сохранённые сообщения и память.
CONTENT_ENCRYPTION_KEY=

# ── Лимиты и бюджет (docs/pricing.md §5) ──────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
DAILY_BUDGET_USD=25
# Аварийный рубильник: true — бот отвечает «технические работы», LLM не вызывается.
KILL_SWITCH=false

# ── Продуктовые параметры ─────────────────────────────────────────────────────
TRIAL_MESSAGE_COUNT=100
CONTEXT_MESSAGE_WINDOW=12
CONTEXT_SUMMARY_EVERY=20
MEMORY_RETRIEVAL_LIMIT=30
MEMORY_EPISODIC_TTL_DAYS=30
